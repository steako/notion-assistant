# Google Gemini API Key (von https://aistudio.google.com/)
# Empfohlen für fehlerfreie deutsche Spracherkennung, Kontext-Verständnis und exakte Termine.
# Pay-as-you-go im AI Studio garantiert volle Privatsphäre (kein Training, keine Human Reviewer).
GEMINI_API_KEY=

# Optional: Separater Gemini Free-Tier API Key für den RSS-Monitor (ebenfalls von https://aistudio.google.com/)
# Da öffentliche RSS-Feeds keine privaten Daten enthalten, läuft die RSS-Zusammenfassung
# damit komplett kostenlos im Free Tier, ohne dein kostenpflichtiges Pay-as-you-go-Guthaben zu belasten.
GEMINI_FREE_API_KEY=

# Optional: E-Mail Lesezugriff (Variante A: Nur markierte Mails mit Sicherheitsfiltern)
# Für Gmail: Erstelle unter https://myaccount.google.com/apppasswords ein 16-stelliges App-Passwort ("NotionAssistent")
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: Notion Internal Integration Token (von https://www.notion.so/profile/integrations)
# Damit kann das lokale Python-Skript komplett eigenständig (auch wenn Antigravity geschlossen ist)
# direkt mit deinen Notion-Datenbanken "AI Inbox" und "Tasks" synchronisieren.
NOTION_TOKEN=

# Optional: Telegram Bot für Sprachnachrichten & Kurznachrichten von unterwegs
# 1. In Telegram @BotFather öffnen -> /newbot -> Token hier eintragen
# 2. Optional: Eigene Chat-ID eintragen (wird beim Senden von /start angezeigt), damit nur du den Bot nutzen kannst
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Separater Telegram Bot für RSS-Feeds & Wissensspeicher (trennt News von Terminen/Notizen)
# 1. In @BotFather einen zweiten Bot erstellen (z. B. RSSBot) -> Token hier eintragen
# 2. Öffne den neuen Bot auf Telegram und tippe einmal auf /start
TELEGRAM_RSSBOT_TOKEN=
TELEGRAM_RSS_CHAT_ID=

# Optional: Lokales Ollama-Modell überschreiben (Standard aus config.json: qwen2.5-coder:7b)
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# TypeSafe AI (Jev) - Schnelles System-One-Entscheidungsmodell ($0.042 / Mtok)
# ==============================================================================
# Optional: API-Key von https://typesafe.ai/ für deterministisches Vorfiltern, Scoring & Routing.
# Schützt vor teuren Gemini-Calls: Nur RSS-Artikel mit hoher Relevanz gehen weiter an Gemini.
TYPESAFE_API_KEY=

# Feste Modellversion (empfohlen: jev-1.13.0, um Schwellenwerte stabil zu halten)
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_S=10

# RSS-Relevanz-Schwellenwert (0.0 bis 1.0; Artikel unter diesem Wert werden direkt verworfen)
JEV_RELEVANCE_THRESHOLD=0.70
JEV_CATEGORY_MIN_CONFIDENCE=0.40

# Verhalten bei Jev-Timeout/Fehler: "gemini" (kontrollierter Fallback) oder "abort"
JEV_FAILURE_MODE=gemini

# DATENSCHUTZ-GUARDRAIL (US-Hosting von TypeSafe AI):
# Im Chat-Assistenten ist Jev standardmäßig DEAKTIVIERT (false), um vertrauliche Notion-Daten
# und persönliche Notizen zu schützen. Bei "true" werden nur anonymisierte Routing-Metadaten
# (maskierte PII) übertragen.
JEV_ALLOW_CHAT_ROUTING=false
